# Copy to .env and adjust. Load it with:   source .env
# .env is gitignored; .env.example is the template.

# Airflow keeps its config, metadata database, logs and dags/ folder here.
# Must be absolute. Points at airflow_home/ inside this project.
export AIRFLOW_HOME="$HOME/projects/airflow-learning/airflow_home"

# Hide the ~50 example DAGs Airflow ships with so your own DAGs are easy to find.
# Any airflow.cfg setting can be overridden as AIRFLOW__<SECTION>__<KEY>.
export AIRFLOW__CORE__LOAD_EXAMPLES=False

# Makes `uv add` / `uv sync` honour the Airflow constraints file without
# passing --constraint every time.
export UV_CONSTRAINT="$HOME/projects/airflow-learning/constraints.txt"

# Homebrew's postgresql@18 is keg-only; this puts psql and pg_isready on PATH.
export PATH="/opt/homebrew/opt/postgresql@18/bin:$PATH"

# Postgres connection for the tutorial pipeline. Local-only test credentials.
export PGHOST=localhost
export PGPORT=5432
export PGDATABASE=airflow_learning
export PGUSER=airflow_learning
export PGPASSWORD=airflow_learning
