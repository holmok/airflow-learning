# Python / uv
.venv/
__pycache__/
*.py[cod]
.python-version

# Local environment
.env
.envrc
.DS_Store

# Airflow runtime state. Everything under airflow_home/ is generated by
# `airflow standalone` except dags/, which is the code we want to keep.
airflow_home/*
!airflow_home/dags/

# airflow.cfg contains fernet_key, secret_key and jwt_secret generated on
# first run. Each machine should generate its own.
airflow_home/airflow.cfg

# Keep sample data, but not anything large or generated you drop in later
data/*.gz
data/*.zip
